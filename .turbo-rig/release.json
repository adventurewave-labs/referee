  "github": {
    "visibility": "public",
    "description": "MCP middleware for task-scoped agent authorization, policy-based redaction, and verifiable tool-call receipts.",
    "topics": ["ai-agents", "authorization", "audit-logging", "go", "information-flow-control", "mcp", "otlp", "policy-engine"],
    "pages": {
      "source_path": "/docs",
      "homepage": "https://adventurewave-labs.github.io/referee/"
    },
    "uat": [
      {"path": "", "contains": "Put MCP tool calls under policy.", "link": "assets/referee-infographic.png"},
      {"path": "", "contains": "SHA-256 checksums", "link": "llms.txt"},
      {"path": "assets/release.css", "contains": "--violet:"},
      {"path": "assets/referee-infographic.svg", "contains": "Verifiable receipt"},
      {"path": "assets/referee-banner.svg", "contains": "@keyframes dispatch"}
    ],
    "discovery": {
      "robots": "shared",
      "agents": ["Googlebot", "OAI-SearchBot"],
      "sitemap": "sitemap.xml",
      "llms": "llms.txt",
      "llms_full": "llms-full.txt",
      "pages": [{"path": "", "lang": "en", "open_graph": true, "schema_types": ["SoftwareApplication"]}]
    }
  },
  "artifacts": {
    "readme": "README.md",
    "readme_downloads": [
      "referee-{tag}-linux-amd64.tar.gz",
      "referee-{tag}-darwin-arm64.tar.gz",
      "SHA256SUMS"
    ],
    "codespace_qa": {
      "script": "scripts/release-smoke.py",
      "asset": "referee-{tag}-linux-amd64.tar.gz"
    },
    "banner_svg": "docs/assets/referee-banner.svg",
    "infographic_svg": "docs/assets/referee-infographic.svg",
    "infographic_png": "docs/assets/referee-infographic.png",
